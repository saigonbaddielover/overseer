#!/usr/bin/env bash
# Read and drive another agent session (Claude Code or Codex) from outside it: a local or remote Linux
# tmux pane, or a console window on a remote Windows host over ssh (the win* commands).
# The controller is Linux-only (uses /proc). Requires: tmux, jq; ssh/scp for remote targets.
# Run OUTSIDE the target pane's tmux client.
set -eu

CLAUDE_HOME="${CLAUDE_HOME:-$HOME/.claude}"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
POLL_INTERVAL="${OVERSEER_POLL_INTERVAL:-0.25}"
DEFAULT_TIMEOUT="${OVERSEER_TIMEOUT:-600}"

_die() { printf 'overseer: %s\n' "$1" >&2; exit 1; }
_die_code() { printf 'overseer: %s\n' "$2" >&2; exit "$1"; }
_need() { command -v "$1" >/dev/null 2>&1 || _die "missing dependency: $1"; }
_uint() { case "${1:-}" in ''|*[!0-9]*) _die "timeout must be a whole number of seconds, got: '${1:-}'" ;; esac; }
_nap() { sleep "$POLL_INTERVAL"; }
case "$POLL_INTERVAL" in
  *[!0-9.]*|*.*.*|''|.) _die "OVERSEER_POLL_INTERVAL must be a positive number of seconds, got: '$POLL_INTERVAL'" ;;
esac
case "${POLL_INTERVAL//[.0]/}" in
  '') _die "OVERSEER_POLL_INTERVAL must be a positive number of seconds, got: '$POLL_INTERVAL'" ;;
esac
_uint "$DEFAULT_TIMEOUT"
QUOTA_WARN="${OVERSEER_QUOTA_WARN:-90}"
_uint "$QUOTA_WARN"
{ [ "$QUOTA_WARN" -ge 1 ] && [ "$QUOTA_WARN" -le 100 ]; } || _die "OVERSEER_QUOTA_WARN must be a percentage between 1 and 100, got: '$QUOTA_WARN'"
QUOTA_TTL="${OVERSEER_QUOTA_TTL:-300}"
_uint "$QUOTA_TTL"
[ "$QUOTA_TTL" -ge 1 ] || _die "OVERSEER_QUOTA_TTL must be a whole number of seconds >= 1, got: '$QUOTA_TTL'"
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]:-0}" -lt 1 ]; }; then
  _die "needs bash >= 4.1 (found ${BASH_VERSION:-unknown}); on macOS install a newer bash (e.g. Homebrew) and run overseer under it"
fi

_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
OVERSEER_SELF="$_dir/$(basename "${BASH_SOURCE[0]}")"
export OVERSEER_SELF
# shellcheck source=lib/discovery.sh
. "$_dir/lib/discovery.sh"
# shellcheck source=lib/transcript.sh
. "$_dir/lib/transcript.sh"
# shellcheck source=lib/tui.sh
. "$_dir/lib/tui.sh"
# shellcheck source=lib/commands.sh
. "$_dir/lib/commands.sh"
# shellcheck source=lib/windows.sh
. "$_dir/lib/windows.sh"

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    list) cmd_list "$@" ;;
    read) cmd_read "$@" ;;
    peek) cmd_peek "$@" ;;
    keys) cmd_keys "$@" ;;
    send) cmd_send "$@" ;;
    unsend) cmd_unsend "$@" ;;
    interrupt) cmd_interrupt "$@" ;;
    chat) cmd_chat "$@" ;;
    wait) cmd_wait "$@" ;;
    fleet) cmd_fleet "$@" ;;
    sh)   cmd_sh "$@" ;;
    quit) cmd_quit "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    slash) cmd_slash "$@" ;;
    menu) cmd_menu "$@" ;;
    usage) cmd_usage "$@" ;;
    doctor) cmd_doctor "$@" ;;
    on) cmd_on "$@" ;;
    deploy) cmd_deploy "$@" ;;
    hosts) cmd_hosts "$@" ;;
    provision) cmd_provision "$@" ;;
    win) cmd_win "$@" ;;
    ''|-h|--help)
      printf 'usage: overseer <command> [args]   (t = a claude PEER name, a tmux pane id %%N, or a session name; the PEER name wins)\n'
      printf '  agent = a Claude Code OR Codex session; read/chat/send/wait auto-detect which.\n'
      printf '  list [--all]               every agent the harness knows, led by PEER (its own name; - when it has none) + REACH: keys+peer (a drivable pane), keys (codex/no name), peer (a live claude with NO tmux pane — only SendMessage reaches it) (--all: every tmux pane + its command)\n'
      printf '  start <name> [shell|claude|codex] [workdir]  create a DETACHED tmux session running a shell/agent (attach to watch); same via "on <host> start ..."\n'
      printf '  stop  <t>                  kill the tmux session (or a %%N pane, or just the pane behind a PEER name) and its child; refuses to kill the session overseer is in\n'
      printf '  read  <t>                  agent: last user prompt + last assistant reply (from transcript)\n'
      printf '  peek  [raw|-e] <t> [lines] full current screen (raw: keep colors -> see active tab/selection; [lines] applies to plain only)\n'
      printf '  chat  [--yes] [--force-keys] <t> <msg|-> [timeout]  agent: send, wait for the reply, print it (queues behind a busy/compacting agent, waits for ITS OWN turn)\n'
      printf '  send  [--yes] [--notify] [--force-keys] <t> <msg|-> [notify_timeout]  agent: paste + verify + submit, confirm the turn started (no reply wait); queues + says so if the agent is busy/compacting\n'
      printf '        a target with a PEER name is REFUSED: keystrokes are recorded as if user typed them, so use the SendMessage tool for an authenticated peer message; --force-keys overrides. a target reached through "on <host>" is never refused: the peer channel does not cross machines\n'
      printf '        every keystroke delivery is prefixed with the sender'"'"'s own PEER name, that it is an agent rather than the user, and how to reply (SendMessage when the target has a PEER name, otherwise "overseer send <sender>")\n'
      printf '        --notify also arms a detached watcher: when that agent leaves its turn (done / stopped at a prompt / died) it PASTES a wake-up into the pane you ran this from, so a dispatcher does not have to sit and poll\n'
      printf '  unsend <t>                 agent: RETRACT the message queued behind the running turn, before it runs (claude only — codex hands a mid-turn message straight to the model as a steer, which nothing can pull back)\n'
      printf '  interrupt [--run-queued] <t>  agent: STOP the running turn (no reply is saved). refuses if a message is queued behind it, because interrupting starts that message immediately — unsend it first, or pass --run-queued\n'
      printf '  wait  <t> [timeout]        agent: block until the turn finishes\n'
      printf '  fleet [--hosts|--tailscale [--os NAME]] [-u USER] [status|read|unsend|interrupt [--run-queued]|wait [--any]|send [--force-keys] [--notify]|chat [--force-keys]] [args]  every LOCAL agent pane at once (default status; send/chat broadcast; unsend/interrupt fan out the per-pane command); with --hosts/--tailscale also fan out over the inventory hosts (each runs "on <host> fleet")\n'
      printf '        wait fans a per-pane wait over all panes; wait --any returns as soon as the FIRST in-flight pane finishes/awaits/exits (for a poll loop); send --notify arms one watcher per pane instead, so you go idle and get woken. a fleet-wide send/chat first PREVIEWS which idle agents would receive it and asks once before sending; --dry-run stops after the preview, --yes skips it (scripts)\n'
      printf '  quit  <t>                  agent: exit the TUI (claude Ctrl-C x2, codex x1), reveal the shell, keep tmux\n'
      printf '  slash <t> </cmd>           agent: run a slash command (/model /status ...; claude /resume /clear ...)\n'
      printf '  menu  <t> <item> [nav-key] any pane: navigate a tab/menu until <item> is highlighted (default key Right; codex popups are vertical -> pass Down)\n'
      printf '  sh    <t> <command> [timeout]        shell pane: run one line, wait, print output+exit\n'
      printf '  keys  <t> <key>...         raw keys to answer prompts/menus (Enter Escape y Up C-c ...)\n'
      printf '  usage [--json] [t]         ACCOUNT quota (%% used per window + reset) and context tokens; no target = this machine. context is informational (it auto-compacts) — quota is the one that stops work\n'
      printf '        claude: read live from https://api.anthropic.com/api/oauth/usage with the OAuth token in $CLAUDE_HOME/.credentials.json (needs curl); codex: from its own rollout. Nothing is installed and no claude config is touched\n'
      printf '        a turn killed by a usage limit is reported by chat/wait as an error with EXIT CODE 5, never as a reply; no quota window at all is normal on a third-party backend\n'
      printf '  doctor [--live]            preflight: Linux/proc, tmux, jq, session state; --live also drives a throwaway pane\n'
      printf '  deploy <host>              copy overseer to ~/.overseer on a remote ssh host (once, before "on")\n'
      printf '  on    <host> <command> [args]  run any overseer command on a remote ssh host (ControlPersist-reused; e.g. on sandbox chat %%0 hi)\n'
      printf '  hosts [--list] [--tailscale] [--os NAME] [-u USER] [-t secs]  survey the fleet: per host print user@host + online/os/ssh/drive-able (inventory from OVERSEER_HOSTS, ~/.ssh/config, or --tailscale; -u sets the login user for bare hosts)\n'
      printf '  provision [--dry-run] <host>  install the missing Linux drive deps (tmux+jq) on a remote ssh host (needs root/passwordless sudo); fixes a hosts DRIVE=no:tmux/no:jq\n'
      printf '  win   <host>[/name] <verb> [args]  drive a remote WINDOWS console broker over ssh (the win prefix is to Windows what "on <host>" is to remote Linux); e.g. overseer win admin@win-host chat "hi"\n'
      printf '        win verbs: show start list peek keys sh read chat send unsend interrupt wait quit stop slash menu\n'
      printf '          start [pwsh|claude|codex] [workdir]  start/switch a VISIBLE broker child (/name on the host to run several side by side; see: win <host> list)\n'
      printf '          show  [app]                          open a GUI app (default Windows Terminal) on the VISIBLE console session\n'
      printf '          peek | keys <key|text>... | sh <command> [timeout]  snapshot the screen / send keys or text / run one pwsh command line\n'
      printf '          chat [--yes] [--force] <prompt|-> [timeout] | send [--yes] [--force] <prompt|->  agent broker: send+wait+reply / send+confirm-started (no wait)\n'
      printf '          wait [timeout] | read | slash </cmd> | menu <item> [nav-key]  block the turn / last prompt+reply / run a slash command / navigate a popup\n'
      printf '          quit | stop                          exit the agent TUI (keep the broker pwsh) / stop the whole broker and its child\n'
      printf "  ('-' as <msg> reads the message from stdin; any length is pasted, not typed)\n"
      ;;
    *) _die "unknown command: $cmd" ;;
  esac
}
main "$@"
